# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
ENV/
env/
.python-version

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ============================================================
# Окружение и секреты — НИКОГДА не коммитим
# ============================================================
.env
.env.*
!.env.example          # ← исключение: шаблон коммитим
secrets/
*.pem
*.key
*.p12

# ============================================================
# Данные проекта
# ============================================================
# Inbox для PDF — содержимое не коммитим, но папку сохраняем
data/raw/*
!data/raw/.gitkeep

# Durable-хранилище файлов — аналогично
data/storage/*
!data/storage/.gitkeep

# Локальные дампы БД, экспорты, временные файлы
*.dump
*.sql.gz
data/backups/

# ============================================================
# Alembic
# ============================================================
# Кэш автогенерации — не нужен в репо
migrations/__pycache__/
migrations/versions/__pycache__/

# ============================================================
# Тесты и кэши
# ============================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml

# mypy / ruff
.mypy_cache/
.dmypy.json
.ruff_cache/

# ============================================================
# Jupyter (если будете экспериментировать)
# ============================================================
.ipynb_checkpoints/
*.ipynb

# ============================================================
# IDE
# ============================================================
# PyCharm / IntelliJ
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# Sublime
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# ============================================================
# OS
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ============================================================
# Логи
# ============================================================
*.log
logs/
uvicorn.log

# ============================================================
# Docker
# ============================================================
# (docker-compose.override.yml — локальные оверрайды,
#  обычно содержат dev-настройки и секреты)
docker-compose.override.yml

# ============================================================
# Node.js (на будущее, если виджет переедет на Vite/React)
# ============================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
.vite/
.next/
.nuxt/

# ============================================================
